# Neon Postgres connection string (Vercel's Neon integration sets this automatically)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth — copy from Neon Console → your project → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth

# Random secret of at least 32 characters used to sign session cookies
# Generate one with:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Invite-only: the code people must enter to create an account (defaults to zzh_zj_99)
SIGNUP_ACCESS_CODE=zzh_zj_99

# Optional Vercel cron bearer secret for the daily inbox retention sweep
CRON_SECRET=
